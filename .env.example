# Public browser configuration. Copy to .env.local and restart Vite.
# Leave both empty for a read-only preview with device-local progress.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use this instead of the publishable key:
# VITE_SUPABASE_ANON_KEY=
# NEVER put service_role, sb_secret_ keys, database passwords, or access tokens here.
